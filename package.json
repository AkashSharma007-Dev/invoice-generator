{
  "name": "invoice-generator",
  "productName": "Invoice Generator",
  "version": "1.7.0",
  "description": "Invoice Generator - Example Travel & Tours",
  "main": "src/main.js",
  "author": "Akash Sharma",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0"
  },
  "build": {
    "appId": "com.akashsharma.invoicegenerator",
    "productName": "Invoice Generator",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "asarUnpack": ["assets/**"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Invoice Generator",
      "artifactName": "Invoice-Generator-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AkashSharma007-Dev",
        "repo": "Invoice-generator-releases",
        "releaseType": "release"
      }
    ]
  }
}
